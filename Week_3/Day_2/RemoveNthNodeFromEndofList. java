        // while(fast!=null && fast.next!=null){
        //     slow=slow.next;
        //     fast=fast.next;
        // }
        // slow.next=slow.next.next;
        // return head;
        







        ListNode s=head,f=head;
        for(int i=1;i<=n;i++) f=f.next;
        if(f==null) return head.next;
        while(f.next!=null){
            s=s.next;f=f.next;
        }
        s.next=s.next.next;
        return head;
    }
}
